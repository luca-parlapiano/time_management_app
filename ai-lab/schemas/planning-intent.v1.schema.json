{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planning-intent.v1",
  "title": "Planning Intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["goals", "habits", "constraints", "preferences", "questions"],
  "properties": {
    "goals": {
      "type": "array",
      "items": { "$ref": "#/$defs/namedItem" }
    },
    "habits": {
      "type": "array",
      "items": { "$ref": "#/$defs/habit" }
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraint" }
    },
    "preferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/preference" }
    },
    "questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    }
  },
  "$defs": {
    "namedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "source": { "type": "string", "enum": ["explicit", "inferred"] }
      }
    },
    "habit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "frequency": { "type": "string", "maxLength": 80 },
        "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 720 },
        "source": { "type": "string", "enum": ["explicit", "inferred"] }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "source"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "source": { "type": "string", "enum": ["explicit", "inferred"] }
      }
    },
    "preference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "source"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "source": { "type": "string", "enum": ["explicit", "inferred"] }
      }
    }
  }
}
